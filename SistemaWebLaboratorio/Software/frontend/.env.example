# ============================================
# BACKEND API CONFIGURATION
# ============================================
# IMPORTANTE: Next.js requiere el prefijo NEXT_PUBLIC_ para variables del cliente
# URL base de la API del backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Clave de cifrado para localStorage (SC-28)
# IMPORTANTE: Cambiar en producción por una clave segura única
# Generar con: openssl rand -base64 32
NEXT_PUBLIC_ENCRYPTION_KEY=LAB-FRANZ-2025-SECURE-KEY-v1

# ============================================
# APPLICATION CONFIGURATION (Opcional)
# ============================================
# Estas son opcionales, pueden comentarse si no se usan
# NEXT_PUBLIC_APP_NAME="Laboratorio Clínico Franz"
# NEXT_PUBLIC_APP_VERSION="1.0.0"
